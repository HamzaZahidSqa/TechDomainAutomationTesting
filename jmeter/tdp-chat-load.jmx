          <boolProp name="TLS">false</boolProp><stringProp name="server"></stringProp><stringProp name="port">80</stringProp><stringProp name="path"></stringProp><stringProp name="connectTimeout">20000</stringProp><stringProp name="payloadType">Text</stringProp><boolProp name="createNewConnection">false</boolProp><boolProp name="loadDataFromFile">false</boolProp><stringProp name="dataFile"></stringProp>
          <stringProp name="requestData">42[&quot;subscribeUser&quot;,{&quot;userId&quot;:${receiverId}}]</stringProp>
        </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
        <hashTree/>
        <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="receiver joinRoom">
          <boolProp name="TLS">false</boolProp><stringProp name="server"></stringProp><stringProp name="port">80</stringProp><stringProp name="path"></stringProp><stringProp name="connectTimeout">20000</stringProp><stringProp name="payloadType">Text</stringProp><boolProp name="createNewConnection">false</boolProp><boolProp name="loadDataFromFile">false</boolProp><stringProp name="dataFile"></stringProp>
          <stringProp name="requestData">42[&quot;joinRoom&quot;,&quot;user_${receiverId}&quot;]</stringProp>
        </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
        <hashTree/>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="listen">
          <stringProp name="WhileController.condition">${__groovy(System.currentTimeMillis() &lt; vars.get('recvUntil').toLong())}</stringProp>
        </WhileController>
        <hashTree>
          <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="receiver read">
            <boolProp name="TLS">false</boolProp><stringProp name="server"></stringProp><stringProp name="port">80</stringProp><stringProp name="path"></stringProp><stringProp name="connectTimeout">20000</stringProp><stringProp name="dataType">Text</stringProp><boolProp name="createNewConnection">false</boolProp><stringProp name="readTimeout">15000</stringProp><boolProp name="optional">true</boolProp>
          </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="classify frame">
              <stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">String f = prev.getResponseDataAsString()
if (f == '2') { vars.put('needPong', '1'); prev.setIgnore(); return }
if (!prev.isSuccessful()) { prev.setSampleLabel('receiver read (error)'); return }
def m = (f =~ /load (\d+)-(\d+)/)
if (!m.find()) { prev.setIgnore(); return }
long sent = m.group(2).toLong(); long now = System.currentTimeMillis()
if (f.startsWith('42["notification"')) { prev.setSampleLabel('notification delivered (customer)') }
else if (f.startsWith('42["unreadCountUpdated"')) { prev.setSampleLabel('inbox unread-count update (customer)') }
else if (f.startsWith('42["receiveMessage"')) { prev.setSampleLabel('receiveMessage (customer)') }
else { prev.setIgnore(); return }
prev.setStartTime(sent); prev.setEndTime(now); prev.setSuccessful(true); prev.setResponseCodeOK(); prev.setResponseMessage((now - sent) + ' ms after send')</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="if ping -> pong">
            <stringProp name="IfController.condition">${__groovy(vars.get('needPong') == '1')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="receiver pong">
              <boolProp name="TLS">false</boolProp><stringProp name="server"></stringProp><stringProp name="port">80</stringProp><stringProp name="path"></stringProp><stringProp name="connectTimeout">20000</stringProp><stringProp name="payloadType">Text</stringProp><boolProp name="createNewConnection">false</boolProp><boolProp name="loadDataFromFile">false</boolProp><stringProp name="dataFile"></stringProp>
              <stringProp name="requestData">3</stringProp>
            </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
            <hashTree>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="reset"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">vars.put('needPong', '0'); if (prev.isSuccessful()) prev.setIgnore()</stringProp></JSR223PostProcessor>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>
        <eu.luminis.jmeter.wssampler.CloseWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.CloseWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.CloseWebSocketSampler" testname="receiver ws close">
          <stringProp name="statusCode">1000</stringProp><stringProp name="readTimeout">3000</stringProp>
        </eu.luminis.jmeter.wssampler.CloseWebSocketSampler>
