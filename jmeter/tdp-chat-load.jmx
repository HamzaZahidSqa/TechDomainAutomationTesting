            <stringProp name="script">long sent = vars.get('sentAt').toLong(); long now = System.currentTimeMillis()
SampleResult.setStartTime(sent); SampleResult.setEndTime(now); SampleResult.setSuccessful(false); SampleResult.setResponseCode('TIMEOUT'); SampleResult.setResponseMessage('no echo for ' + vars.get('msgId') + ' after ' + (now - sent) + ' ms')</stringProp>
          </JSR223Sampler>
