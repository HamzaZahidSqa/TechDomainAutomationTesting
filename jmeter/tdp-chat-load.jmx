<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="TDP chat latency under N active users">
      <stringProp name="TestPlan.comments">Measures chat message round-trip and notification delivery while N active users poll the API and hold a socket. Props: users ramp duration senders senderRamp senderDelay senderDuration receiverDelay receiverDuration host accountsCsv nAccounts room wo senderId senderRole receiverId receiverRole companyId</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="host" elementType="Argument"><stringProp name="Argument.name">host</stringProp><stringProp name="Argument.value">${__P(host,api.dev.techdomain.com.au)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="accountsCsv" elementType="Argument"><stringProp name="Argument.name">accountsCsv</stringProp><stringProp name="Argument.value">${__P(accountsCsv,accounts.csv)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="nAccounts" elementType="Argument"><stringProp name="Argument.name">nAccounts</stringProp><stringProp name="Argument.value">${__P(nAccounts,6)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="room" elementType="Argument"><stringProp name="Argument.name">room</stringProp><stringProp name="Argument.value">${__P(room,1821)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="wo" elementType="Argument"><stringProp name="Argument.name">wo</stringProp><stringProp name="Argument.value">${__P(wo,989)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="companyId" elementType="Argument"><stringProp name="Argument.name">companyId</stringProp><stringProp name="Argument.value">${__P(companyId,9)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="senderId" elementType="Argument"><stringProp name="Argument.name">senderId</stringProp><stringProp name="Argument.value">${__P(senderId,27)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="senderRole" elementType="Argument"><stringProp name="Argument.name">senderRole</stringProp><stringProp name="Argument.value">${__P(senderRole,CLIENT)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="receiverId" elementType="Argument"><stringProp name="Argument.name">receiverId</stringProp><stringProp name="Argument.value">${__P(receiverId,638)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="receiverRole" elementType="Argument"><stringProp name="Argument.name">receiverRole</stringProp><stringProp name="Argument.value">${__P(receiverRole,CUSTOMER)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="wsPath" elementType="Argument"><stringProp name="Argument.name">wsPath</stringProp><stringProp name="Argument.value">/socket.io/?EIO=4&amp;transport=websocket</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <stringProp name="HTTPSampler.domain">${host}</stringProp>
        <stringProp name="HTTPSampler.protocol">https</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">15000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">60000</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Common headers">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
          <elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
          <elementProp name="" elementType="Header"><stringProp name="Header.name">Origin</stringProp><stringProp name="Header.value">https://dev.techdomain.com.au</stringProp></elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>

      <!-- ============ setUp: log in every account once, share tokens via props ============ -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp: logins">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${nAccounts}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </SetupThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="accounts.csv">
          <stringProp name="filename">${accountsCsv}</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">role,email,password</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">true</boolProp>
          <boolProp name="recycle">true</boolProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="setUp POST /auth/login">
          <stringProp name="HTTPSampler.path">/api/auth/login</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;email&quot;:&quot;${email}&quot;,&quot;password&quot;:&quot;${password}&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="extract token + uid">
            <stringProp name="JSONPostProcessor.referenceNames">token;uid;refresh</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.accessToken;$.data.id;$.refreshToken</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1;1;1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOTFOUND;0;NOTFOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="store token in props">
            <stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get('token') == 'NOTFOUND') { log.warn('login failed for ' + vars.get('email')); return }
int i = (props.get('nAcc') ?: '0').toInteger()
String role = vars.get('role') ?: ''
String sr = role == 'TechDomain User' ? 'CLIENT' : (role == 'Admin' ? 'ADMIN' : (role.startsWith('Customer') ? 'CUSTOMER' : 'FREELANCER'))
props.put('token_' + i, vars.get('token')); props.put('refresh_' + i, vars.get('refresh')); props.put('uid_' + i, vars.get('uid')); props.put('srole_' + i, sr); props.put('nAcc', String.valueOf(i + 1))
log.info('setUp: account ' + i + ' = user ' + vars.get('uid') + ' (' + sr + ')')</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ============ Token refresher: access tokens live 60s, refresh every 40s ============ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Token refresher">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,330)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="refresh tokens">
          <stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper
int n = (props.get('nAcc') ?: '0').toInteger(); int okc = 0
for (int i = 0; i &lt; n; i++) {
  try {
    def c = (HttpURLConnection) new URL('https://' + vars.get('host') + '/api/auth/refreshToken').openConnection()
    c.setRequestMethod('POST'); c.setDoOutput(true); c.setConnectTimeout(15000); c.setReadTimeout(30000)
    c.setRequestProperty('Content-Type', 'application/json'); c.setRequestProperty('Accept', 'application/json'); c.setRequestProperty('Origin', 'https://dev.techdomain.com.au')
    c.getOutputStream().withWriter('UTF-8') { it &lt;&lt; ('{"oldRefreshToken":"' + props.get('refresh_' + i) + '"}') }
    int code = c.getResponseCode()
    String body = (code &lt; 400 ? c.getInputStream() : c.getErrorStream())?.getText('UTF-8') ?: ''
    if (code &lt; 300) {
      def j = new JsonSlurper().parseText(body); def d = (j.data instanceof Map &amp;&amp; j.data.accessToken) ? j.data : j
      props.put('token_' + i, d.accessToken); props.put('refresh_' + i, d.refreshToken); okc++
    } else { log.warn('refresh ' + i + ' -> ' + code + ' ' + body.take(200)) }
  } catch (Exception e) { log.warn('refresh ' + i + ' failed: ' + e) }
}
SampleResult.setResponseMessage('refreshed ' + okc + '/' + n); SampleResult.setSuccessful(okc == n &amp;&amp; n &gt; 0)</stringProp>
        </JSR223Sampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="every 40s"><stringProp name="ConstantTimer.delay">40000</stringProp></ConstantTimer>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ============ Active users: HTTP polling + one socket each ============ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Active users">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(users,1000)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,120)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,330)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="once: pick account + open socket"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="pick account">
            <stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">int n = (props.get('nAcc') ?: '0').toInteger()
if (n == 0) { SampleResult.setSuccessful(false); SampleResult.setResponseMessage('no tokens from setUp'); return }
int i = ctx.getThreadNum() % n
vars.put('acc', String.valueOf(i)); vars.put('uid', props.get('uid_' + i)); vars.put('srole', props.get('srole_' + i)); vars.put('needPong', '0')
SampleResult.setIgnore()</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <eu.luminis.jmeter.wssampler.OpenWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.OpenWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.OpenWebSocketSampler" testname="user ws open">
            <boolProp name="TLS">true</boolProp><stringProp name="server">${host}</stringProp><stringProp name="port">443</stringProp><stringProp name="path">${wsPath}</stringProp><stringProp name="connectTimeout">15000</stringProp><stringProp name="readTimeout">10000</stringProp>
          </eu.luminis.jmeter.wssampler.OpenWebSocketSampler>
          <hashTree/>
          <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="user eio handshake">
            <boolProp name="TLS">false</boolProp><stringProp name="server"></stringProp><stringProp name="port">80</stringProp><stringProp name="path"></stringProp><stringProp name="connectTimeout">20000</stringProp><stringProp name="dataType">Text</stringProp><boolProp name="createNewConnection">false</boolProp><stringProp name="readTimeout">10000</stringProp><boolProp name="optional">false</boolProp>
          </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
          <hashTree/>
          <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="user sio connect">
            <boolProp name="TLS">false</boolProp><stringProp name="server"></stringProp><stringProp name="port">80</stringProp><stringProp name="path"></stringProp><stringProp name="connectTimeout">20000</stringProp><stringProp name="payloadType">Text</stringProp><boolProp name="createNewConnection">false</boolProp><boolProp name="loadDataFromFile">false</boolProp><stringProp name="dataFile"></stringProp>
            <stringProp name="requestData">40{&quot;userId&quot;:${uid},&quot;role&quot;:&quot;${srole}&quot;}</stringProp>
          </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
          <hashTree/>
          <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="user sio connected">
            <boolProp name="TLS">false</boolProp><stringProp name="server"></stringProp><stringProp name="port">80</stringProp><stringProp name="path"></stringProp><stringProp name="connectTimeout">20000</stringProp><stringProp name="dataType">Text</stringProp><boolProp name="createNewConnection">false</boolProp><stringProp name="readTimeout">10000</stringProp><boolProp name="optional">false</boolProp>
          </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
          <hashTree/>
          <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="user subscribeUser">
            <boolProp name="TLS">false</boolProp><stringProp name="server"></stringProp><stringProp name="port">80</stringProp><stringProp name="path"></stringProp><stringProp name="connectTimeout">20000</stringProp><stringProp name="payloadType">Text</stringProp><boolProp name="createNewConnection">false</boolProp><boolProp name="loadDataFromFile">false</boolProp><stringProp name="dataFile"></stringProp>
            <stringProp name="requestData">42[&quot;subscribeUser&quot;,{&quot;userId&quot;:${uid}}]</stringProp>
          </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
          <hashTree/>
          <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="user joinRoom">
            <boolProp name="TLS">false</boolProp><stringProp name="server"></stringProp><stringProp name="port">80</stringProp><stringProp name="path"></stringProp><stringProp name="connectTimeout">20000</stringProp><stringProp name="payloadType">Text</stringProp><boolProp name="createNewConnection">false</boolProp><boolProp name="loadDataFromFile">false</boolProp><stringProp name="dataFile"></stringProp>
            <stringProp name="requestData">42[&quot;joinRoom&quot;,&quot;user_${uid}&quot;]</stringProp>
          </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
          <hashTree/>
        </hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Authorization">
          <collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${__groovy(props.get('token_' + vars.get('acc')))}</stringProp></elementProp></collectionProp>
        </HeaderManager>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="user GET /inbox"><stringProp name="HTTPSampler.path">/api/inbox?limit=20</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="200"><collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="user GET /notifications"><stringProp name="HTTPSampler.path">/api/notifications?limit=10&amp;page=1</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="200"><collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="user GET /notifications/others"><stringProp name="HTTPSampler.path">/api/notifications/others?limit=10&amp;page=1</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="200"><collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="user GET /users/me"><stringProp name="HTTPSampler.path">/api/users/me</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="200"><collectionProp name="Asserion.test_strings"><stringProp name="49586">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion>
          <hashTree/>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="think 3-6s"><stringProp name="ConstantTimer.delay">3000</stringProp><stringProp name="RandomTimer.range">3000.0</stringProp></UniformRandomTimer>
          <hashTree/>
        </hashTree>
        <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="user ws poll">
          <boolProp name="TLS">false</boolProp><stringProp name="server"></stringProp><stringProp name="port">80</stringProp><stringProp name="path"></stringProp><stringProp name="connectTimeout">20000</stringProp><stringProp name="dataType">Text</stringProp><boolProp name="createNewConnection">false</boolProp><stringProp name="readTimeout">300</stringProp><boolProp name="optional">true</boolProp>
        </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="handle ping">
            <stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">String f = prev.getResponseDataAsString()
if (f == '2') { vars.put('needPong', '1') }
if (prev.isSuccessful()) { prev.setIgnore() } else { prev.setSampleLabel('user ws poll (error)') }</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="if ping -> pong">
          <stringProp name="IfController.condition">${__groovy(vars.get('needPong') == '1')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="user pong">
            <boolProp name="TLS">false</boolProp><stringProp name="server"></stringProp><stringProp name="port">80</stringProp><stringProp name="path"></stringProp><stringProp name="connectTimeout">20000</stringProp><stringProp name="payloadType">Text</stringProp><boolProp name="createNewConnection">false</boolProp><boolProp name="loadDataFromFile">false</boolProp><stringProp name="dataFile"></stringProp>
            <stringProp name="requestData">3</stringProp>
          </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="reset"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">vars.put('needPong', '0'); if (prev.isSuccessful()) prev.setIgnore()</stringProp></JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>

      <!-- ============ Chat senders (Tech Domain user) ============ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Chat senders">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(senders,10)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(senderRamp,10)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(senderDuration,180)}</stringProp>
        <stringProp name="ThreadGroup.delay">${__P(senderDelay,130)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="sender init">
          <stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">vars.put('joined', '0'); vars.put('tries', '0'); vars.put('gotEcho', '0'); vars.put('needPong', '0'); SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
        <hashTree/>
